{
  "name": "rota-ready",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @rota-ready/api exec prisma generate && pnpm --parallel --filter \"./apps/*\" dev",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm db:migrate",
    "db:migrate": "pnpm --filter @rota-ready/api db:migrate",
    "build": "pnpm -r build",
    "lint": "eslint . --max-warnings 0",
    "lint:migrations": ".github/scripts/lint-migrations.sh",
    "test:migrations": ".github/scripts/test-migrations.sh",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @rota-ready/api exec prisma generate && pnpm -r test",
    "test:coverage": "pnpm --filter @rota-ready/api exec prisma generate && pnpm -r --no-bail test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^10.15.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "squawk-cli": "2.72.0",
    "supabase": "3.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
