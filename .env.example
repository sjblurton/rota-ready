# Copy to .env (git-ignored). The values below work with the local Supabase stack.

# Postgres for the API and Prisma (local Supabase).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Port the API listens on.
PORT=3000

# Where the Vite dev server proxies /api requests (dev only).
API_PROXY_TARGET=http://localhost:3000

# Base URL the web app calls the API on. Leave empty locally to use the dev proxy.
VITE_API_URL=

# Local Supabase Auth (values from `pnpm exec supabase status`). The API checks tokens against this issuer.
SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
