# Copy to .env (git-ignored). The values below work with the local Supabase stack.

# Postgres for the API and Prisma (local Supabase).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Port the API listens on.
PORT=3000

# Where the Vite dev server proxies /api requests (dev only).
API_PROXY_TARGET=http://localhost:3000

# Base URL the web app calls the API on. Leave empty locally to use the dev proxy.
VITE_API_URL=

# Local Supabase Auth (values from `pnpm exec supabase status`). The API checks tokens against this issuer.
SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Encrypts stored Staff Link tokens: 32 random bytes, base64. This value is for local
# development only; generate a new one for each environment with `openssl rand -base64 32`.
STAFF_LINK_KEY=tc4v/Is59G2hiYt4iJ67lajAKl/sMj/dICW2CsFhd4g=

# Where the API sends email. Locally, the Supabase mail inbox (Mailpit): read it at http://127.0.0.1:54324.
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM=Rota Ready <rota@example.com>

# The web app's address, used for the Staff Links in emails.
WEB_URL=http://localhost:5173

# Ask about this week (ADR-0012). Leave the key empty to turn the feature off; the tests and the journey never need it.
# The model and answer length default to claude-haiku-5-5 and 400 tokens.
ANTHROPIC_API_KEY=
