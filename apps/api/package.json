{
  "name": "@rota-ready/api",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "prisma generate && tsdown",
    "start": "node --env-file-if-exists=../../.env dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migration": "prisma migrate dev --create-only"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@rota-ready/shared": "workspace:*",
    "express": "^5.3.0",
    "i18next": "^27.1.3",
    "jose": "^6.2.17",
    "nodemailer": "10.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "tsdown": "^0.23.7",
    "tsx": "^4.23.15",
    "vite": "8.3.8"
  }
}
