generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          String        @id @db.Uuid
  email       String
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  memberships VenueMember[]

  @@map("users")
}

model Venue {
  id           String        @id @default(uuid()) @db.Uuid
  name         String
  timeZone     String        @map("time_zone")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  members      VenueMember[]
  staffMembers StaffMember[]
  rotas        Rota[]
  shifts       Shift[]

  @@map("venues")
}

enum MemberRole {
  owner

  @@map("member_role")
}

model VenueMember {
  userId    String     @map("user_id") @db.Uuid
  venueId   String     @map("venue_id") @db.Uuid
  role      MemberRole
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue     Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
  @@unique([userId])
  @@index([venueId])
  @@map("venue_members")
}

model StaffMember {
  id                       String         @id @default(uuid()) @db.Uuid
  venueId                  String         @map("venue_id") @db.Uuid
  name                     String
  role                     String
  email                    String?
  phone                    String?
  archivedAt               DateTime?      @map("archived_at") @db.Timestamptz
  staffLinkTokenHash       String?        @unique @map("staff_link_token_hash")
  staffLinkTokenCiphertext String?        @map("staff_link_token_ciphertext")
  createdAt                DateTime       @default(now()) @map("created_at") @db.Timestamptz
  venue                    Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  shifts                   Shift[]        @relation("ShiftStaffMember")
  toldShifts               Shift[]        @relation("ShiftToldStaffMember")
  previousShifts           Shift[]        @relation("ShiftPreviousStaffMember")
  shiftRemovals            ShiftRemoval[]

  @@unique([venueId, email])
  @@map("staff_members")
}

enum RotaStatus {
  draft
  published

  @@map("rota_status")
}

model Rota {
  id          String     @id @default(uuid()) @db.Uuid
  venueId     String     @map("venue_id") @db.Uuid
  weekStart   DateTime   @map("week_start") @db.Date
  status      RotaStatus @default(draft)
  publishedAt DateTime?  @map("published_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz
  venue       Venue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  shifts      Shift[]

  @@unique([venueId, weekStart])
  @@map("rotas")
}

enum ShiftResponse {
  pending
  confirmed
  declined

  @@map("shift_response")
}

model Shift {
  id                    String         @id @default(uuid()) @db.Uuid
  venueId               String         @map("venue_id") @db.Uuid
  rotaId                String         @map("rota_id") @db.Uuid
  staffMemberId         String         @map("staff_member_id") @db.Uuid
  startsAt              DateTime       @map("starts_at") @db.Timestamptz
  endsAt                DateTime       @map("ends_at") @db.Timestamptz
  role                  String?
  notes                 String?
  response              ShiftResponse  @default(pending)
  declineReason         String?        @map("decline_reason")
  respondedAt           DateTime?      @map("responded_at") @db.Timestamptz
  toldStaffMemberId     String?        @map("told_staff_member_id") @db.Uuid
  toldStartsAt          DateTime?      @map("told_starts_at") @db.Timestamptz
  toldEndsAt            DateTime?      @map("told_ends_at") @db.Timestamptz
  previousStaffMemberId String?        @map("previous_staff_member_id") @db.Uuid
  previousStartsAt      DateTime?      @map("previous_starts_at") @db.Timestamptz
  previousEndsAt        DateTime?      @map("previous_ends_at") @db.Timestamptz
  deletedAt             DateTime?      @map("deleted_at") @db.Timestamptz
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  venue                 Venue          @relation(fields: [venueId], references: [id], onDelete: Cascade)
  rota                  Rota           @relation(fields: [rotaId], references: [id], onDelete: Cascade)
  staffMember           StaffMember    @relation("ShiftStaffMember", fields: [staffMemberId], references: [id], onDelete: Restrict)
  toldStaffMember       StaffMember?   @relation("ShiftToldStaffMember", fields: [toldStaffMemberId], references: [id], onDelete: Restrict)
  previousStaffMember   StaffMember?   @relation("ShiftPreviousStaffMember", fields: [previousStaffMemberId], references: [id], onDelete: Restrict)
  removals              ShiftRemoval[]

  @@index([rotaId, startsAt])
  @@index([staffMemberId, startsAt])
  @@index([toldStaffMemberId, toldStartsAt])
  @@map("shifts")
}

model ShiftRemoval {
  id            String      @id @default(uuid()) @db.Uuid
  shiftId       String      @map("shift_id") @db.Uuid
  staffMemberId String      @map("staff_member_id") @db.Uuid
  startsAt      DateTime    @map("starts_at") @db.Timestamptz
  endsAt        DateTime    @map("ends_at") @db.Timestamptz
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  shift         Shift       @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  staffMember   StaffMember @relation(fields: [staffMemberId], references: [id], onDelete: Restrict)

  @@unique([shiftId, staffMemberId])
  @@index([staffMemberId, startsAt])
  @@map("shift_removals")
}
