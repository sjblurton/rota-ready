{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/ui-types",
    "rootDir": "src",
    "tsBuildInfoFile": "node_modules/.tmp/ui-types/tsconfig.ui.tsbuildinfo",
    "exactOptionalPropertyTypes": false,
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/components/ui"]
}
